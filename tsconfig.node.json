{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["shared/*"] },
    "tsBuildInfoFile": "node_modules/.tmp/node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "api", "shared"]
}
